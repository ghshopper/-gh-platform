require "base64"
require "json"

default_platform(:ios)

# The App Store app "GH Shopper" (id 6801456059) uses this bundle id,
# so the new app ships as an update of the same listing.
WORKSPACE = "ios/GHShopper.xcworkspace"
PROJECT = "ios/GHShopper.xcodeproj"
SCHEME = "GHShopper"
ENTITLEMENTS = "ios/GHShopper/GHShopper.entitlements"

platform :ios do
  lane :beta do
    bundle_id = ENV.fetch("BUNDLE_ID")
    team_id = ENV.fetch("APPLE_TEAM_ID")
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
      is_key_content_base64: false,
      in_house: false
    )

    bid = Spaceship::ConnectAPI::BundleId.find(bundle_id)
    UI.user_error!("Bundle id #{bundle_id} not found in this Apple account") unless bid
    caps = bid.get_capabilities.map(&:capability_type)
    UI.message("Capabilities on #{bundle_id}: #{caps.join(', ')}")

    changed = false
    unless caps.include?("PUSH_NOTIFICATIONS")
      bid.update_capability("PUSH_NOTIFICATIONS", enabled: true)
      changed = true
      UI.important("Enabled Push Notifications on #{bundle_id}")
    end

    # Apple Pay needs the merchant id linked to the App ID in the developer
    # portal. If it isn't, build without it (card payments still work).
    unless caps.include?("APPLE_PAY")
      UI.important("Apple Pay is not enabled on #{bundle_id}; building without the Apple Pay entitlement")
      ent = File.join("..", ENTITLEMENTS)
      if File.exist?(ent)
        sh("/usr/libexec/PlistBuddy -c 'Delete :com.apple.developer.in-app-payments' '#{File.expand_path(ent)}' || true")
      end
    end

    repo = ENV.fetch("GITHUB_REPOSITORY")
    match(
      type: "appstore",
      app_identifier: bundle_id,
      team_id: team_id,
      api_key: api_key,
      storage_mode: "git",
      git_url: "https://github.com/#{repo}.git",
      git_branch: "certificates",
      git_basic_authorization: Base64.strict_encode64("x-access-token:#{ENV.fetch('GITHUB_TOKEN')}"),
      readonly: false,
      force: changed
    )
    profile_name = ENV["sigh_#{bundle_id}_appstore_profile-name"]

    update_code_signing_settings(
      use_automatic_signing: false,
      path: PROJECT,
      targets: [SCHEME],
      team_id: team_id,
      bundle_identifier: bundle_id,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name
    )

    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      export_team_id: team_id,
      export_options: { provisioningProfiles: { bundle_id => profile_name } },
      output_directory: "build/ipa",
      output_name: "GHShopper.ipa",
      xcargs: "-allowProvisioningUpdates"
    )

    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
